# MongoDB Atlas database user connection string (URL-encode special characters in the password)
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=fati_designs

# Use a long random secret; do not use this placeholder in production
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=720

# Comma-separated frontend origins; include scheme, omit trailing slash
CORS_ORIGINS=http://localhost:5173,https://your-site.vercel.app

# Cloudinary dashboard credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SEED_SAMPLE=1
